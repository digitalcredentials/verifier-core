{
  "name": "@digitalcredentials/verifier-core",
  "description": "For verifying Verifiable Credentials in the browser, Node.js, and React Native.",
  "version": "2.0.0",
  "scripts": {
    "build": "pnpm run clear && tsc",
    "clear": "rimraf dist/*",
    "dev": "vite",
    "fix": "eslint --fix src test && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\"",
    "lint": "eslint src test",
    "prepare": "pnpm run build",
    "rebuild": "pnpm run clear && pnpm run build",
    "test": "pnpm run lint && pnpm run test:node",
    "test:browser": "playwright test",
    "test:node": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "type": "module",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./openbadges": {
      "types": "./dist/openbadges/index.d.ts",
      "react-native": "./dist/openbadges/index.js",
      "import": "./dist/openbadges/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@digitalcredentials/data-integrity": "^2.6.0",
    "@digitalcredentials/did-io": "^1.0.2",
    "@digitalcredentials/did-method-key": "^3.0.0",
    "@digitalcredentials/did-method-web": "^1.1.0",
    "@digitalcredentials/ed25519-multikey": "^1.4.0",
    "@digitalcredentials/ed25519-signature-2020": "^7.0.0",
    "@digitalcredentials/eddsa-rdfc-2022-cryptosuite": "^1.3.0",
    "@digitalcredentials/jsonld-signatures": "^12.0.1",
    "@digitalcredentials/security-document-loader": "^8.0.0",
    "@digitalcredentials/vc": "^10.0.0",
    "@digitalcredentials/vc-bitstring-status-list": "^1.0.0",
    "@interop/ecdsa-multikey": "^2.3.2",
    "@interop/ecdsa-signature": "^2.0.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "klona": "^2.0.6",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@digitalcredentials/ed25519-verification-key-2020": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "dcc"
  ],
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0"
  },
  "author": {
    "name": "Digital Credentials Consortium",
    "url": "https://github.com/digitalcredentials/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalcredentials/verifier-core"
  },
  "homepage": "https://github.com/digitalcredentials/verifier-core",
  "bugs": "https://github.com/digitalcredentials/verifier-core"
}
